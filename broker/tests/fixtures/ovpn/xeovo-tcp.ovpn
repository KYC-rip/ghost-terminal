client
dev tun
proto tcp
remote vpn.example.net 443
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
tun-mtu 1500
dhcp-option DNS 10.8.0.1
dhcp-option DNS 10.8.0.2
verb 3

<ca>
-----BEGIN CERTIFICATE-----
MIIBszCCAVmgAwIBAgIUXo6Y5FevW1bGpT3KqC2KDRJZW0kwCgYIKoZIzj0EAwIw
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
MIIBszCCAVmgAwIBAgIUXo6Y5FevW1bGpT3KqC2KDRJZW0kCCaAwCgYIKoZIzj0E
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgvHfG7CbFh4K2Qa
-----END PRIVATE KEY-----
</key>
