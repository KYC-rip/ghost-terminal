client
dev tun
proto udp
remote vpn.example.net 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name vpn.example.net name
auth SHA256
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-GCM
tun-mtu 1500
dhcp-option DNS 10.8.0.1
verb 3

<ca>
-----BEGIN CERTIFICATE-----
MIIBszCCAVmgAwIBAgIUXo6Y5FevW1bGpT3KqC2KDRJZW0kwCgYIKoZIzj0EAwIw
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
MIIBszCCAVmgAwIBAgIUXo6Y5FevW1bGpT3KqC2KDRJZW0kCCaAwCgYIKoZIzj0E
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgvHfG7CbFh4K2Qa
-----END PRIVATE KEY-----
</key>

<tls-auth>
# 2048 bit OpenVPN static key
-----BEGIN OpenVPN Static key V1-----
e68bd664c43b37d6d0f9cb2c4b5d8ab8
-----END OpenVPN Static key V1-----
</tls-auth>
