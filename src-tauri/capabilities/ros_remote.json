{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ros-remote",
  "description": "Remote RipleyOS (ui_mode=ros, beta): ONLY the invoke surface ripley-os/src/os/platform/native.ts actually uses — the wallet channel, routing config, Tor status, the ROS browser, and the classic-exit toggle. Deliberately NO fs:*, shell:*, dialog:*, or core:default: the page is served from app.ros.rip, so a compromised CDN / MITM must never reach the filesystem or a shell. Keep this list in sync with native.ts.",
  "local": false,
  "remote": {
    "urls": ["https://app.ros.rip"]
  },
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",

    "allow-ros-native-fetch",
    "allow-resolve-openalias",
    "allow-get-config",
    "allow-save-config",
    "allow-save-config-and-reload",
    "allow-watch-sync-set",
    "allow-get-tor-status",
    "allow-tor-circuit",
    "allow-restart-tor",
    "allow-open-native-browser",
    "allow-browser-embed-open",
    "allow-browser-embed-bounds",
    "allow-browser-embed-navigate",
    "allow-browser-embed-zoom",
    "allow-browser-embed-visible",
    "allow-browser-embed-close",
    "allow-browser-embed-deliver-xmr402",

    "allow-create-wallet",
    "allow-open-wallet",
    "allow-close-wallet",
    "allow-get-mnemonic",
    "allow-verify-password",
    "allow-change-wallet-password",
    "allow-get-accounts",
    "allow-create-account",
    "allow-rename-account",
    "allow-get-balance",
    "allow-get-height",
    "allow-get-subaddresses",
    "allow-create-subaddress",
    "allow-set-subaddress-label",
    "allow-estimate-fees",
    "allow-get-transactions",
    "allow-get-outputs",
    "allow-get-tx-key",
    "allow-get-tx-proof",
    "allow-sign-message",
    "allow-check-tx-key",
    "allow-check-tx-proof",
    "allow-rescan",
    "allow-reselect-node",
    "allow-prepare-transfer",
    "allow-relay-transfer",
    "allow-sweep-all",
    "allow-sweep-single",
    "allow-get-identities",
    "allow-save-identities",
    "allow-switch-identity",
    "allow-delete-identity",
    "allow-arm-transfer-grant",
    "allow-relay-transfer-grant",
    "allow-revoke-transfer-grant",
    "allow-revoke-all-transfer-grants",
    "allow-transfer-grant-status",
    "allow-save-xmr402-payment",
    "allow-get-xmr402-payment",
    "allow-get-all-xmr402-payments",
    "allow-agent-gateway-status",
    "allow-agent-gateway-set-config",
    "allow-agent-gateway-rotate-key",

    "allow-set-ui-mode"
  ]
}
