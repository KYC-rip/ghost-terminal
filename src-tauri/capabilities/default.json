    "allow-get-mnemonic",
    "allow-get-accounts",
    "allow-create-account",
    "allow-rename-account",
    "allow-get-balance",
    "allow-get-height",
    "allow-get-subaddresses",
    "allow-create-subaddress",
    "allow-set-subaddress-label",
    "allow-estimate-fees",
