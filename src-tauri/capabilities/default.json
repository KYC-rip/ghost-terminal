{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Full permissions for the LOCAL classic renderer only. Local-context (no `remote`), so a remote page loaded into the main window inherits none of this — remote RipleyOS gets the narrow ros_remote capability instead.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:webview:default",
    "shell:default",
    "shell:allow-open",
    "fs:default",
    "dialog:default",
    "deep-link:default",

    "allow-create-wallet",
